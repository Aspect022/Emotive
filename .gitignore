# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
env/
venv/
ENV/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large binaries & cache
*.zip
*.tar.gz
*.7z
*.npz
*.pt
*.pth
data/processed/
Data/

# EEG data folder — put X_raw.npy, y_task.npy, participant_ids.npy here
# Files are ignored (too large for git), but the folder is tracked via .gitkeep
data/*
!data/.gitkeep

# Benchmark — generated at runtime (too large for git)
eeg_cache/
bench_out/
logs/*.log

# Numpy memmap / large feature dumps
*.dat
*.npy
*.npy.bak

# Jupyter checkpoints
.ipynb_checkpoints/
*.ipynb

# Benchmark result JSONs (keep leaderboard.md, not raw JSON)
bench_out/
Results2/

# Scratch / output text files
scripts/*.txt

